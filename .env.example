# Copy to .env and adjust. Never commit .env.

APP_ENV=development

# Storage
DOWNLOAD_DIR=downloads
TEMP_DIR=temp
SESSION_DIR=sessions
TOKEN_DIR=tokens
DATA_DIR=data

# Logging
LOG_LEVEL=INFO

# Google Drive
DEFAULT_DRIVE_FOLDER=Instagram-Knowledge-Base
UPLOAD_CHUNK_SIZE=5242880
MAX_UPLOAD_RETRIES=3

# Instagram
MAX_INSTAGRAM_RETRIES=3

# Dashboard login
SESSION_TIMEOUT_MINUTES=60
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Cleanup
CLEANUP_TEMP_FILES=false
